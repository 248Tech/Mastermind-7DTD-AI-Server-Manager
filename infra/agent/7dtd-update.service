[Unit]
Description=Apply 7DTD stable Steam updates if available
After=network-online.target
Wants=network-online.target
Before=7dtd.service
DefaultDependencies=yes

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=1800
User=root
Group=root
ExecStart=/usr/local/sbin/mastermind-update-7dtd-stable

[Install]
WantedBy=multi-user.target
