# Copy to infra/.env and set values before running in production.
# docker compose reads this file automatically when run from the infra/ directory.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=mastermind
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mastermind
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Auth secrets (CHANGE THESE IN PRODUCTION) ────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_AGENT_SECRET=change-me-in-production

# ── Ports ─────────────────────────────────────────────────────────────────────
CP_PORT=3001
WEB_PORT=3000

# ── Web build arg (must match the public URL users see in their browser) ──────
NEXT_PUBLIC_CONTROL_PLANE_URL=http://localhost:3001

# ── Optional Discord command bot (`--profile discord-bot`) ───────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_ALLOWED_ROLE_IDS=
DISCORD_ALLOWED_USER_IDS=
DISCORD_EPHEMERAL_REPLIES=true
MASTERMIND_URL=http://control-plane:3001
MASTERMIND_EMAIL=
MASTERMIND_PASSWORD=
MASTERMIND_ORG_ID=
MASTERMIND_SERVER_ID=
JOB_TIMEOUT_SECONDS=600
