DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Recommended during setup: guild commands appear immediately.
DISCORD_GUILD_ID=
# Optional comma-separated authorization lists. If both are empty,
# Discord members with Administrator or Manage Server may run commands.
DISCORD_ALLOWED_ROLE_IDS=
DISCORD_ALLOWED_USER_IDS=
DISCORD_EPHEMERAL_REPLIES=true

# From the bot container, use the Compose service name. For a standalone bot,
# use the reachable Mastermind URL, such as http://127.0.0.1:3001.
MASTERMIND_URL=http://control-plane:3001
MASTERMIND_EMAIL=
MASTERMIND_PASSWORD=
# Optional. Login's first organization and first 7DTD server are used otherwise.
MASTERMIND_ORG_ID=
MASTERMIND_SERVER_ID=
JOB_TIMEOUT_SECONDS=600
