# Control Plane — copy to .env (do not commit .env)
PORT=3001
DATABASE_URL=postgresql://mastermind:changeme@localhost:5432/mastermind
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=change-me-user-secret
JWT_AGENT_SECRET=change-me-agent-secret
EMAIL_VERIFICATION_SECRET=change-me-verification-secret
OPENAI_KEY_ENCRYPTION_SECRET=change-me-integration-encryption-secret
AUTH_RATE_LIMIT_SECRET=change-me-rate-limit-secret
PUBLIC_WEB_URL=http://localhost:3000

# Allocs WebAPI (hostiles, animals, inventory, visitmap). Inventory and
# executeconsolecommand require a webtoken; location reads can work on the
# private network without one.
SEVENDTD_WEB_URL=http://host.docker.internal:8080
SEVENDTD_WEB_API_TOKEN_NAME=mastermind
SEVENDTD_WEB_API_SECRET=

# Stripe Checkout for Steam-tied player donations. Leave blank to keep
# checkout disabled. Webhook URL: https://<PUBLIC_WEB_URL host>/api/donations/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Set these before the first seed. The password is used only when the email
# does not already exist; minimum 12 characters.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password
BOOTSTRAP_ADMIN_NAME=Administrator
